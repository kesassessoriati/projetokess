[general]
static=yes
writeprotect=no
clearglobalvars=no

[globals]
WEBRTC_RING_GROUP=PJSIP/${WEBRTC_EXTENSION}
SIP_TRUNK_HOST=${SIP_TRUNK_HOST}

[from-webrtc]
exten => _+X.,1,NoOp(Outbound WebRTC call to ${EXTEN})
 same => n,Set(SELECTED_DID=${FILTER(0-9,${PJSIP_HEADER(read,X-AtendZappy-DID)})})
 same => n,ExecIf($["${SELECTED_DID}" = ""]?Set(SELECTED_DID=${WEBRTC_DEFAULT_DID}))
 same => n,Set(OUTBOUND_NUMBER=${EXTEN:1})
 same => n,Gosub(normalize-outbound-number,s,1(${OUTBOUND_NUMBER}))
 same => n,Set(CALLERID(num)=${SELECTED_DID})
 same => n,Dial(PJSIP/${OUTBOUND_NUMBER}@sipserver-endpoint,60,b(add-outbound-headers^s^1(${SELECTED_DID})))
 same => n,Hangup()

exten => _X.,1,NoOp(Outbound WebRTC call to ${EXTEN})
 same => n,Set(SELECTED_DID=${FILTER(0-9,${PJSIP_HEADER(read,X-AtendZappy-DID)})})
 same => n,ExecIf($["${SELECTED_DID}" = ""]?Set(SELECTED_DID=${WEBRTC_DEFAULT_DID}))
 same => n,Set(OUTBOUND_NUMBER=${EXTEN})
 same => n,Gosub(normalize-outbound-number,s,1(${OUTBOUND_NUMBER}))
 same => n,Set(CALLERID(num)=${SELECTED_DID})
 same => n,Dial(PJSIP/${OUTBOUND_NUMBER}@sipserver-endpoint,60,b(add-outbound-headers^s^1(${SELECTED_DID})))
 same => n,Hangup()

[add-outbound-headers]
exten => s,1,NoOp(Add outbound SIP identity headers for DID ${ARG1})
 same => n,Set(PJSIP_HEADER(add,P-Preferred-Identity)=<sip:${ARG1}@${SIP_TRUNK_HOST}>)
 same => n,Set(PJSIP_HEADER(add,P-Asserted-Identity)=<sip:${ARG1}@${SIP_TRUNK_HOST}>)
 same => n,Return()

[normalize-outbound-number]
exten => s,1,Set(OUTBOUND_NUMBER=${FILTER(0-9,${ARG1})})
 same => n,ExecIf($["${OUTBOUND_NUMBER:0:2}" = "00"]?Set(OUTBOUND_NUMBER=${OUTBOUND_NUMBER:2}))
 same => n,ExecIf($["${OUTBOUND_NUMBER:0:1}" = "0" & ${LEN(${OUTBOUND_NUMBER})} >= 11]?Set(OUTBOUND_NUMBER=${OUTBOUND_NUMBER:1}))
 same => n,ExecIf($["${OUTBOUND_NUMBER:0:2}" != "55" & (${LEN(${OUTBOUND_NUMBER})} = 10 | ${LEN(${OUTBOUND_NUMBER})} = 11)]?Set(OUTBOUND_NUMBER=55${OUTBOUND_NUMBER}))
 same => n,Set(FIRST_SUBSCRIBER_DIGIT=${OUTBOUND_NUMBER:4:1})
 same => n,Set(IS_MOBILE_PREFIX=${REGEX("^[6-9]" ${FIRST_SUBSCRIBER_DIGIT})})
 same => n,ExecIf($["${OUTBOUND_NUMBER:0:2}" = "55" & ${LEN(${OUTBOUND_NUMBER})} = 12 & ${IS_MOBILE_PREFIX} = 1]?Set(OUTBOUND_NUMBER=${OUTBOUND_NUMBER:0:4}9${OUTBOUND_NUMBER:4}))
 same => n,Return()

[from-sipserver]
exten => ${WEBRTC_DEFAULT_DID},1,NoOp(Inbound SIPServer DID ${EXTEN})
 same => n,Dial(${WEBRTC_RING_GROUP},45)
 same => n,Hangup()

exten => _X.,1,NoOp(Inbound SIPServer fallback DID ${EXTEN})
 same => n,Dial(${WEBRTC_RING_GROUP},45)
 same => n,Hangup()

