[global]
type=global
user_agent=AtendZappy-Asterisk

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
external_signaling_address=${ASTERISK_PUBLIC_IP}
external_media_address=${ASTERISK_PUBLIC_IP}
local_net=10.0.0.0/8
local_net=172.16.0.0/12
local_net=192.168.0.0/16

[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0

[sipserver-aor]
type=aor
contact=sip:${SIP_TRUNK_HOST}:${SIP_TRUNK_PORT}

[sipserver-auth]
type=auth
auth_type=userpass
username=${SIP_TRUNK_USERNAME}
password=${SIP_TRUNK_PASSWORD}

[sipserver-endpoint]
type=endpoint
transport=transport-udp
context=from-sipserver
disallow=all
allow=ulaw
allow=alaw
aors=sipserver-aor
outbound_auth=sipserver-auth
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
from_user=${SIP_TRUNK_USERNAME}
from_domain=${SIP_TRUNK_HOST}

[sipserver-identify]
type=identify
endpoint=sipserver-endpoint
match=${SIP_TRUNK_HOST}

[${WEBRTC_EXTENSION}]
type=endpoint
transport=transport-ws
context=from-webrtc
disallow=all
allow=opus
allow=ulaw
allow=alaw
auth=${WEBRTC_EXTENSION}-auth
aors=${WEBRTC_EXTENSION}
webrtc=yes
use_avpf=yes
media_encryption=dtls
dtls_auto_generate_cert=yes
dtls_verify=fingerprint
dtls_setup=actpass
ice_support=yes
rtcp_mux=yes
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[${WEBRTC_EXTENSION}-auth]
type=auth
auth_type=userpass
username=${WEBRTC_EXTENSION}
password=${WEBRTC_PASSWORD}

[${WEBRTC_EXTENSION}]
type=aor
max_contacts=5
remove_existing=yes

